include README.md LICENSE THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include requirements.txt requirements-dev.txt
recursive-include src *.py
recursive-include tests *.py
recursive-include examples *.py *.json
recursive-include docs *.md
global-exclude __pycache__ *.py[cod] *.safetensors *.pt *.pth *.bin *.pkl *.pickle
